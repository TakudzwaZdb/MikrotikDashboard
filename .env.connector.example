# LAPTOP connector settings  (copy to .env on the laptop:  copy .env.connector.example .env)
# Needs NO database and NO JWT_SECRET. Only these:
DATABASE_URL=postgres://dashboard:Tawananyasha22@localhost:5432/mikrotik_dashboard
# Your Render address, exactly as in the browser, no trailing slash
RENDER_URL=https://mikrotikdashboard3.onrender.com
# Must be IDENTICAL to CONNECTOR_TOKEN in Render > Environment (long random text)
CONNECTOR_TOKEN=vGFv3SZ0NIEtADq8z5h+K1F+xbxv/AzpYHwHA9Z+XAWIg+/5ZrJxj1tP9aS/MODA
JWT_SECRET=HtKLxBIrnRk1F7ThcT7rbY6W2l9yt+tCmg8BWumnEuYNaGf6X0o1iPJomMDjV49r
# The router, as seen FROM THIS LAPTOP (ipconfig > Default Gateway)
MIKROTIK_HOST=192.168.88.1
# Plain API: 8728 + MIKROTIK_USE_TLS=false      API-SSL: 8729 + MIKROTIK_USE_TLS=true
# A mismatch looks exactly like a "timeout"!
MIKROTIK_PORT=8728
MIKROTIK_USE_TLS=false
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=Tawananyasha@22

# seconds between router reads
USAGE_POLL_INTERVAL=10
# pings Render every 10 min so a free instance is less likely to go to sleep (set false to disable)
KEEPALIVE=true
