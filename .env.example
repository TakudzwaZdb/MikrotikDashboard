PORT=8080
DATABASE_URL=postgres://dashboard:Tawananyasha@22@localhost:5432/mikrotik_dashboard
MIKROTIK_HOST=
MIKROTIK_PORT=8729
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=Tawananyasha@22
MIKROTIK_USE_TLS=true
USAGE_POLL_INTERVAL=10
AUTO_DISCONNECT_SUSPICIOUS=false
AUTO_BLOCK_SUSPICIOUS=false
JWT_SECRET=HtKLxBIrnRk1F7ThcT7rbY6W2l9yt+tCmg8BWumnEuYNaGf6X0o1iPJomMDjV49r
CORS_ORIGIN=http://localhost:5173
ADMIN_USER=admin
ADMIN_PASSWORD=Tawananyasha@22

# Automatic cap: disconnect -> block -> remove voucher when a voucher reaches this much data (GiB). 0 disables.
DATA_CAP_GB=2.5
DATA_CAP_REMOVE_USER=true
# Also block the device MAC for N hours after the cap (0 = don't block the device)
DATA_CAP_BLOCK_DEVICE_HOURS=24

# ---- ALERTS (optional): get a message when the router goes offline / comes back, a voucher hits its data cap, or a MEDIUM/HIGH alert fires ----
# Telegram (free): create a bot with @BotFather -> token; message the bot once, then open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT=
# or any GET webhook containing {text}, e.g. WhatsApp via CallMeBot: https://api.callmebot.com/whatsapp.php?phone=2637XXXXXXXX&apikey=YOURKEY&text={text}
NOTIFY_WEBHOOK_URL=
# send the "router offline" alert after this many failed syncs in a row (each sync = USAGE_POLL_INTERVAL seconds)
NOTIFY_OFFLINE_AFTER_FAILS=3
