# Copy to .env (cp / copy .env.local.example .env) and fill in.
PUBLIC_URL=https://YOUR-NAME.ngrok-free.app
DB_PASSWORD=change_this_long_random_password
JWT_SECRET=paste_a_random_string_of_48+_characters
ADMIN_USER=admin
ADMIN_PASSWORD=choose_a_strong_password_10+_chars

# Router on the SAME network as this laptop (no tunnel needed)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=dashboard
MIKROTIK_PASSWORD=
MIKROTIK_USE_TLS=false

USAGE_POLL_INTERVAL=10
AUTO_DISCONNECT_SUSPICIOUS=false
AUTO_BLOCK_SUSPICIOUS=false
DATA_CAP_GB=2.5
DATA_CAP_REMOVE_USER=true
DATA_CAP_BLOCK_DEVICE_HOURS=24
