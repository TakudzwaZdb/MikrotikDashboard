# Copy to .env on the server and fill in.  (cp .env.production.example .env)
DOMAIN=yourname.duckdns.org
DB_PASSWORD=change_this_long_random_password
JWT_SECRET=paste_a_random_string_of_48+_characters
ADMIN_USER=admin
ADMIN_PASSWORD=choose_a_strong_password_10+_chars

# MikroTik (reached through the laptop's SSH tunnel - see SSH-TUNNEL.md; 172.28.0.1 is the docker gateway the tunnel listens on)
MIKROTIK_HOST=172.28.0.1
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_USE_TLS=false

USAGE_POLL_INTERVAL=10
AUTO_DISCONNECT_SUSPICIOUS=false
AUTO_BLOCK_SUSPICIOUS=false
DATA_CAP_GB=2.5
DATA_CAP_REMOVE_USER=true
DATA_CAP_BLOCK_DEVICE_HOURS=24
